@using OnlineCourseSystem.Extensions
@model OnlineCourseSystem.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3>@Model.CourseName</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Course ID</dt>
                <dd class="col-sm-9">@Model.CourseId</dd>

                <dt class="col-sm-3">Duration</dt>
                <dd class="col-sm-9">@Model.Duration</dd>

                <dt class="col-sm-3">Original Fees</dt>
                <dd class="col-sm-9">@Model.Fees.ToString("C")</dd>

                <dt class="col-sm-3">Discount Available</dt>
                <dd class="col-sm-9">@Model.DiscountPercentage%</dd>

                <dt class="col-sm-3">Final Fees (After Discount)</dt>
                <dd class="col-sm-9 text-success fs-5">
                    <strong>@Model.CalculateFinalFees().ToString("C")</strong>
                </dd>
            </dl>
            <small class="text-muted">Response cached timestamp: @DateTime.Now.ToString("T")</small>
        </div>
        <div class="card-footer">
            <a class="btn btn-success" asp-action="Enroll" asp-route-courseId="@Model.CourseId">Proceed to Enroll</a>
            <a class="btn btn-secondary" asp-action="Index">Back to List</a>
        </div>
    </div>
</div>