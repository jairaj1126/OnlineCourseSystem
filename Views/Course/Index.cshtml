@using OnlineCourseSystem.Extensions
@model IEnumerable<OnlineCourseSystem.Models.Course>

@{
    ViewData["Title"] = "Available Courses";
}

<div class="container mt-4">
    <h2>Available Courses</h2>
    <p class="text-muted">Courses loaded via IMemoryCache (5-min expiration).</p>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Course Name</th>
                <th>Duration</th>
                <th>Base Fees</th>
                <th>Discount</th>
                <th>Final Fees</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.CourseId</td>
                    <td>@course.CourseName</td>
                    <td>@course.Duration</td>
                    <td>@course.Fees.ToString("C")</td>
                    <td>@course.DiscountPercentage%</td>
                    <td><strong>@course.CalculateFinalFees().ToString("C")</strong></td>
                    <td>
                        <!-- Passing CourseId via Query String -->
                        <a class="btn btn-sm btn-info" asp-controller="Course" asp-action="Details" asp-route-id="@course.CourseId">View Details</a>
                        <a class="btn btn-sm btn-success" asp-controller="Course" asp-action="Enroll" asp-route-courseId="@course.CourseId">Enroll</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Users" class="btn btn-outline-primary">View Student Directory (External API)</a>
</div>