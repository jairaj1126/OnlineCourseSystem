@model IEnumerable<OnlineCourseSystem.Models.ExternalUser>

@{
    ViewData["Title"] = "User Directory";
}

<div class="container mt-4">
    <h3>External User Directory</h3>
    <p class="text-muted">Data retrieved asynchronously from <code>https://jsonplaceholder.typicode.com/users</code></p>

    <table class="table table-bordered table-hover">
        <thead class="table-secondary">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Company</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Company?.Name</td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-secondary">Back to Courses</a>
</div>